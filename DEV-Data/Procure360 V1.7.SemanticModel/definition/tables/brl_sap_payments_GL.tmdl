	column LateBucket_ExclTol = ```
			
			VAR tol  = 7
			VAR Due  = brl_sap_payments_GL[DueDate]
			VAR Paid = brl_sap_payments_GL[AP_Clearing_Date]
			VAR Diff = IF(NOT ISBLANK(Due) && NOT ISBLANK(Paid), DATEDIFF(Due, Paid, DAY))
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Diff)        , BLANK(),
			    Diff <= tol          , BLANK(),      -- within tolerance → not late
			    Diff <= 15           , "8–15 Days",
			    Diff <= 30           , "16–30 Days",
			    Diff <= 60           , "31–60 Days",
			                            ">60 Days"
			)
			
			```
		lineageTag: 3a401011-f654-43d8-8fa9-ef3eb0c7062a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column LatePaymentDaysBucket_Sort = ```
			
			SWITCH(
			    brl_sap_payments_GL[LateBucket_ExclTol],
			    "8–15 Days", "A",
			    "16–30 Days", "B",
			    "31–60 Days", "C",
			    ">60 Days",  "D",
			    "Z"
			)
			
			```
		lineageTag: dfc06180-4e83-473e-912a-c7253a31be8e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column OverdueDays_Open = ```
			
			VAR Due = brl_sap_payments_GL[DueDate]
			RETURN
			IF(
			    ISBLANK(brl_sap_payments_GL[AP_Clearing_Date]) &&
			    NOT ISBLANK(Due) &&
			    Due < TODAY(),
			    DATEDIFF(Due, TODAY(), DAY)
			    // else BLANK()
			)
			
			```
		formatString: 0
		lineageTag: d59dff33-4786-4655-bd68-78991d95552c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column OverdueDays_Bucket = ```
			
			VAR Due  = brl_sap_payments_GL[DueDate]
			VAR Paid = brl_sap_payments_GL[AP_Clearing_Date]
			VAR Days =
			    IF(
			        ISBLANK(Paid) && NOT ISBLANK(Due) && Due < TODAY(),
			        DATEDIFF(Due, TODAY(), DAY)
			    )
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Days)         , BLANK(),
			    Days <= 7             , "1–7 Days",
			    Days <= 15            , "8–15 Days",
			    Days <= 30            , "16–30 Days",
			    Days <= 60            , "31–60 Days",
			    Days <= 90            , "61–90 Days",
			                            ">90 Days"
			)
			
			```
		lineageTag: 44bed916-e537-417b-92ab-e17eb1d789ca
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column OverdueDays_Bucket_Sort = ```
			
			SWITCH(
			    brl_sap_payments_GL[OverdueDays_Bucket],
			    "1–7 Days", "A",
			    "8–15 Days", "B",
			    "16–30 Days", "C",
			    "31–60 Days", "D",
			    "61–90 Days", "E",
			    ">90 Days",  "F",
			    BLANK()
			)
			
			```
		lineageTag: 9569fdfd-e485-4244-9789-f5f8fed7c625
