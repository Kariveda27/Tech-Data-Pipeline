	column Category1 = ```
			
			VAR GL = brl_sap_payments_GL[glaccount]
			RETURN
			    SWITCH (
			        TRUE(),
			        LEFT ( GL, 1 ) IN { "1", "2" } && NOT ( GL IN { "240100", "240105" } ), "Others",
			        GL IN { "240100", "240105" }, "Direct",
			        LEFT ( GL, 1 ) = "5", "Direct",
			        LEFT ( GL, 1 ) IN { "4", "6", "7", "8", "9" }, "Indirect",
			        "Uncategorized"
			    )
			
			```
