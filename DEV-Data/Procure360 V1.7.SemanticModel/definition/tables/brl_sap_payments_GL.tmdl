	column 'Commodity mapping' = brl_sap_payments_GL[vendorsinvoicenumber] & brl_sap_payments_GL[suppliernumber]
		lineageTag: 3c15fdec-94db-4720-8197-cbf839993a26
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column AP_Paid = ```
			
			CALCULATE(
			    MAX(brl_sap_payments_AP[ispaid]),
			    FILTER(
			        brl_sap_payments_AP,
			        brl_sap_payments_AP[Commodity Mapping] = brl_sap_payments_GL[Commodity mapping]
			    )
			)
			
			```
		lineageTag: b854e252-bf19-4f67-86dc-c661ad8ae942
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column DueDate = ```
			
			IF(
			    ISBLANK(brl_sap_payments_GL[AP_Baseline_Date]) 
			        || ISBLANK(brl_sap_payments_GL[ExtractedPaymentTerms]),
			    BLANK(),
			    brl_sap_payments_GL[AP_Baseline_Date] 
			        + brl_sap_payments_GL[ExtractedPaymentTerms]
			)
			
			```
		formatString: dd/mm/yyyy
		lineageTag: 380144e2-ee64-42db-bf8b-ac6dc1f74445
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 86b4a0a2-ef30-409f-9bfd-2d73c302e2ea
			defaultHierarchy: LocalDateTable_2ed8c2fc-1c65-4249-a6d7-0e59641bd8b9.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column PaymentDays = ```
			
			VAR postDate = brl_sap_payments_GL[AP_Baseline_Date]
			VAR payDate = brl_sap_payments_GL[AP_Clearing_Date]
			RETURN
			IF(
			    NOT(ISBLANK(postDate)) && NOT(ISBLANK(payDate)),
			    DATEDIFF(postDate, payDate, DAY)
			)
			
			```
		formatString: 0
		lineageTag: 1678128c-3f2c-4ccd-956b-5f517b041ce6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Due Days' = ```
			
			DATEDIFF(
			    TODAY(),
			    brl_sap_payments_GL[DueDate],
			    DAY
			)
			
			```
		formatString: 0
		lineageTag: 814e622c-3b7a-407d-80ea-869bd14f7b71
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ExtractedPaymentTerms = ```
			
			SWITCH(
			    TRUE(),
			    'brl_sap_payments_GL'[supplierpayterms] IN {"0001", "CRED", "IC00", "LPA", "NT00", "PFP", "RID"}, 0,
			    'brl_sap_payments_GL'[SupplierPayTerms] = "IN69", 69,
			    'brl_sap_payments_GL'[SupplierPayTerms] = "ME30", 30,
			    'brl_sap_payments_GL'[SupplierPayTerms] = "ME60", 60,
			    'brl_sap_payments_GL'[SupplierPayTerms] = "NT07", 7,
			    'brl_sap_payments_GL'[SupplierPayTerms] = "NT08", 8,
			    'brl_sap_payments_GL'[SupplierPayTerms] = "NT14", 14,
			    'brl_sap_payments_GL'[SupplierPayTerms] = "NT15", 15,
			    'brl_sap_payments_GL'[SupplierPayTerms] = "NT28", 28,
			    'brl_sap_payments_GL'[SupplierPayTerms] = "NT30", 30,
			    'brl_sap_payments_GL'[SupplierPayTerms] = "NT45", 45,
			    'brl_sap_payments_GL'[SupplierPayTerms] = "NT60", 60,
			    'brl_sap_payments_GL'[SupplierPayTerms] = "NT90", 90,
			    BLANK()
			)
			
			
			
			```
		formatString: 0
		lineageTag: c9413959-25fd-4515-8121-3204715a947e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ExtractedPaymentTermsBand = ```
			
			SWITCH(
			    TRUE(),
			    'brl_sap_payments_GL'[ExtractedPaymentTerms] = 0, "0 Days",
			    'brl_sap_payments_GL'[ExtractedPaymentTerms] > 0 && 'brl_sap_payments_GL'[ExtractedPaymentTerms] <= 15, "1–15 Days",
			    'brl_sap_payments_GL'[ExtractedPaymentTerms] > 15 && 'brl_sap_payments_GL'[ExtractedPaymentTerms] <= 30, "16–30 Days",
			    'brl_sap_payments_GL'[ExtractedPaymentTerms] > 30 && 'brl_sap_payments_GL'[ExtractedPaymentTerms] <= 45, "31–45 Days",
			    'brl_sap_payments_GL'[ExtractedPaymentTerms] > 45 && 'brl_sap_payments_GL'[ExtractedPaymentTerms] <= 60, "46–60 Days",
			    'brl_sap_payments_GL'[ExtractedPaymentTerms] > 60 && 'brl_sap_payments_GL'[ExtractedPaymentTerms] <= 75, "61–75 Days",
			    'brl_sap_payments_GL'[ExtractedPaymentTerms] > 75 && 'brl_sap_payments_GL'[ExtractedPaymentTerms] <= 90, "76–90 Days",
			    "90+ Days"
			)
			
			```
		lineageTag: 1625fd6a-b947-4229-addf-27499b242428
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Invoice Age' = ```
			
			DATEDIFF(
			    brl_sap_payments_GL[DueDate],
			    TODAY(),
			    DAY
			)
			
			```
		formatString: 0
		lineageTag: fb6e28ba-dc84-4548-92e3-a840e749ef73
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column RevisedPaymentStatus = ```
			
			VAR Due = 'brl_sap_payments_GL'[DueDate]     
			VAR Paid = 'brl_sap_payments_GL'[AP_Clearing_Date]    
			VAR TodayDate = TODAY()
			VAR DaysEarly = Due - Paid
			VAR DaysLate = Paid - Due
			
			RETURN 
			SWITCH(
			    TRUE(),
			    
			    // Invoice is unpaid and overdue
			    ISBLANK(Paid) && Due < TodayDate, "Unpaid",
			
			    // Invoice is unpaid but not due yet
			    ISBLANK(Paid) && Due >= TodayDate, "Not Due",
			
			    // Paid exactly on due date
			    NOT(ISBLANK(Paid)) && Paid = Due, "On Time",
			
			    // Paid within ±7 days of due date
			    NOT(ISBLANK(Paid)) && ABS(DaysLate) <= 7, "On Time",
			
			    // Paid early by more than 7 days
			    NOT(ISBLANK(Paid)) && DaysEarly > 7, "Early Payment",
			
			    // Paid late by more than 7 days
			    NOT(ISBLANK(Paid)) && DaysLate > 7, "Late Payment",
			
			    "Unknown"
			)
			
			```
		lineageTag: 9b20a928-4c46-44bd-9184-f15c3ae4b57c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column PaymentTimingCategory = ```
			
			VAR Due = 'brl_sap_payments_GL'[DueDate]
			VAR Paid = 'brl_sap_payments_GL'[AP_Clearing_Date]
			VAR DaysEarly = Due - Paid
			VAR DaysLate = Paid - Due
			
			RETURN 
			SWITCH(
			    TRUE(),
			
			    // Unpaid and past due
			    ISBLANK(Paid) && Due < TODAY(), "Late - Unpaid",
			
			    // Unpaid but not due yet
			    ISBLANK(Paid) && Due >= TODAY(), "Not Due",
			
			    // Early Payment Buckets
			    DaysEarly > 0 && DaysEarly <= 7, "Early: 1–7 Days",
			    DaysEarly > 7 && DaysEarly <= 15, "Early: 8–15 Days",
			    DaysEarly > 15 && DaysEarly <= 30, "Early: 16–30 Days",
			    DaysEarly > 30 && DaysEarly <= 60, "Early: 31–60 Days",
			    DaysEarly > 60 && DaysEarly <= 90, "Early: 61–90 Days",
			    DaysEarly > 90, "Early: >90 Days",
			
			    // Late Payment Buckets
			    DaysLate > 0 && DaysLate <= 7, "Late: 1–7 Days",
			    DaysLate > 7 && DaysLate <= 15, "Late: 8–15 Days",
			    DaysLate > 15 && DaysLate <= 30, "Late: 16–30 Days",
			    DaysLate > 30 && DaysLate <= 60, "Late: 31–60 Days",
			    DaysLate > 60 && DaysLate <= 90, "Late: 61–90 Days",
			    DaysLate > 90, "Late: >90 Days",
			
			    // Paid exactly on time or unmatched
			    "On Time"
			)
			
			```
		lineageTag: 0cacb5e6-3868-4a4a-b3fa-771109c8ad3e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column InvoiceAgeBucket_Sort = ```
			
			VAR Age = brl_sap_payments_GL[Invoice Age]
			RETURN 
			SWITCH(
			    TRUE(),
			    ISBLANK(Age), "Z",
			    Age <= 30, "A",
			    Age <= 60, "B",
			    Age <= 90, "C",
			    Age <= 120, "D",
			    Age <= 180, "E",
			    Age <= 365, "F",
			    Age > 365, "G",
			    "Z"
