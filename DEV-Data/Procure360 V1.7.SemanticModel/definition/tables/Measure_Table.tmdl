		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Adjusted_Spend_Overall = ```
			
			VAR SelectedPercentage = SELECTEDVALUE('Spend %'[Parameter], 0)
			RETURN 
			SUM(brl_sap_payments_GL[$ Spend]) * ( SelectedPercentage / 100)
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
