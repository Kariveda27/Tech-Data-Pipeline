	measure '% Spend with Contract' = ```
			
			DIVIDE(
			    CALCULATE(
			        SUM('sam_aic'[Spend]),
			        'sam_aic'[with_contract] = "Yes"
			        || ISBLANK(sam_aic[with_contract])
			    ),
			    SUM('sam_aic'[Spend]),
			    0
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: AIC
		lineageTag: 90834304-a308-4751-966d-72ad7b311829

	measure '% Spend with PO' =
			
			DIVIDE(
			    CALCULATE(
			        SUM('sam_aic'[Spend]),
			        'sam_aic'[with_po] = "Yes"
			            || ISBLANK('sam_aic'[with_po])
			    ),
			    SUM('sam_aic'[Spend]),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: AIC
		lineageTag: 0cb2e369-30dc-4109-80c5-e35972baf801

	measure '% Contracts Published On Time' = ```
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(sam_coupa_contracts),
			        DATEDIFF(sam_coupa_contracts[created_at], sam_coupa_contracts[published_date], DAY) <= 30
			    ),
			    COUNTROWS(sam_coupa_contracts)
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Contracts
		lineageTag: 2aa4e3d3-7ec6-4366-a258-e14276527d08

	measure 'AWPT COUPA' = ```
			
			DIVIDE(
			    [Weighted Payment Terms Coupa],
			    SUM(sam_coupa_invoices_lines[$ Spend]),
			    0
			)
			
			```
		displayFolder: Invoices
		lineageTag: 7e956601-268c-4dd8-8853-87353ae18873

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weighted Payment Terms Coupa' = ```
			
			SUMX(
			    FILTER(
			        sam_coupa_invoices_lines,
			        NOT ISBLANK(sam_coupa_invoices_lines[$ Spend]) &&
			        NOT ISBLANK(sam_coupa_invoices_lines[header_PTband]) 
			    ),
			    sam_coupa_invoices_lines[$ Spend] *
			    sam_coupa_invoices_lines[header_PTband]
			)
			
			```
		displayFolder: Invoices
		lineageTag: 575aa87a-2148-44e9-a823-d29cbbcfc9f6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% e-Invoices' = ```
			
			DIVIDE(
			    CALCULATE(
			        COUNT('sam_coupa_invoices_lines'[invoice_id]),
			        'sam_coupa_invoices_lines'[header_status] = "approved",
			        'sam_coupa_invoices_lines'[header_channel] IN { "csp", "api", "compliance_service", "cxml", "san", "sftp" }
			    ),
			    CALCULATE(
			        COUNT('sam_coupa_invoices_lines'[invoice_id]),
			        'sam_coupa_invoices_lines'[header_status] = "approved"
			    )
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Invoices
		lineageTag: 05a6780a-cb44-4b53-ba44-58a92a56ba37

	measure '% Paid On Time' = ```
			
			DIVIDE(
			    CALCULATE(
			        COUNT('sam_coupa_invoices_lines'[invoice_id]),
			        'sam_coupa_invoices_lines'[header_paid] = "true",
			        ABS(DATEDIFF('sam_coupa_invoices_lines'[DueDate_Created], 'sam_coupa_invoices_lines'[payment_date_line], DAY)) <= 7
			    ),
			    CALCULATE(
			        COUNT('sam_coupa_invoices_lines'[invoice_id]),
			        'sam_coupa_invoices_lines'[header_paid] = "true"
			    )
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Invoices
		lineageTag: 80951d72-54f3-44f4-a95f-da0e2c8459b5

	measure 'Avg Invoice Processing Time (Days)' = ```
			
			AVERAGEX(
			    VALUES('sam_coupa_invoices_lines'[invoice_id]),
			    ABS(
			        DATEDIFF(
			            MIN('sam_coupa_invoices_lines'[created_at]),
			            MAX('sam_coupa_invoices_lines'[header_approval_date]),
			            DAY
			        )
			    )
			)
			
			```
		displayFolder: Invoices
		lineageTag: 67c43690-2470-4ed4-9f28-b56d6bdbbb9e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Days to Pay (Avg, per invoice)' = ```
			
			AVERAGEX(
			    VALUES(sam_coupa_invoices_lines[invoice_id]),
			    MIN(sam_coupa_invoices_lines[DaysToPay_Line])  
			)
			
			```
		displayFolder: Invoices
		lineageTag: 558c4919-4435-4222-bc06-29b02b586c39

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Orders Sent (cXML/XML/Email)' = ```
			
			VAR ValidStatuses = { "issued", "soft_closed", "closed" }
			VAR SentTransmissionStatuses = { "sent_via_cxml", "sent_via_email"}
			
			VAR Numerator =
			    CALCULATE(
			        DISTINCTCOUNT(sam_coupa_orders_headers[id]),
			        sam_coupa_orders_headers[status] IN ValidStatuses,
			        sam_coupa_orders_headers[transmission_status] IN SentTransmissionStatuses
			    )
			
			VAR Denominator =
			    CALCULATE(
			        DISTINCTCOUNT(sam_coupa_orders_headers[id]),
			        sam_coupa_orders_headers[status] IN ValidStatuses
			    )
			
			RETURN
			DIVIDE(Numerator, Denominator)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: PO
		lineageTag: 561d6512-bc24-43e3-a614-180314a8d3bc

	measure '% POs with Contracts' = ```
			
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT(sam_coupa_orders_headers[po_number]),
			        sam_coupa_orders_headers[Contract Flag] = "With contract"
			    ),
			    DISTINCTCOUNT(sam_coupa_orders_headers[po_number])
			)
			
			```
