	measure 'PR Approval Cycle (Days)' = ```
			
			CALCULATE(
			    AVERAGEX(
			        sam_coupa_requisition_headers,
			        DATEDIFF(
			            sam_coupa_requisition_headers[created_at_date],
			            sam_coupa_requisition_headers[Latest Approval Date],
			            DAY
			        )
			    ),
			    TREATAS(
			        VALUES(sam_coupa_orders_headers[requisition_id]),
			        sam_coupa_requisition_headers[id]
			    )
			)
			
			```
