	measure AvgTAT_InternalForms = ```
			
			AVERAGEX(
			    FILTER(
			        ADDCOLUMNS(
			            SUMMARIZE(
			                sam_coupa_approval_supplier_information,
			                sam_coupa_approval_supplier_information[approvable_id]
			            ),
			            "SubmittedDate",
			                CALCULATE(
			                    MIN(sam_coupa_approval_supplier_information[submitted_at]),
			                    sam_coupa_approval_supplier_information[approval_chain_name] = "Internal form approval for SIM"
			                ),
			            "ApprovedDate",
			                CALCULATE(
			                    MAX(sam_coupa_approval_supplier_information[approval_date]),
			                    sam_coupa_approval_supplier_information[approvable_status] IN {"applied", "applied_manually"}
			                )
			        ),
			        NOT ISBLANK([SubmittedDate]) && NOT ISBLANK([ApprovedDate])
			    ),
			    DATEDIFF([SubmittedDate], [ApprovedDate], DAY)
			)
			
			```
		displayFolder: Suppliers
		lineageTag: 365aeb75-2c01-4bcb-a334-eb10326332c8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure OnboardingDurationDays_Updated = ```
			
			VAR InternalSubmitted =
			    CALCULATE(
			        MIN(sam_coupa_approval_supplier_information[submitted_at]),
			        FILTER(
			            sam_coupa_approval_supplier_information,
			            sam_coupa_approval_supplier_information[approval_chain_name] = "Internal form approval for SIM"
			        )
			    )
			
			VAR ExternalApproved =
			    CALCULATE(
			        MAX(sam_coupa_approval_supplier_information[approval_date]),
			        FILTER(
			            sam_coupa_approval_supplier_information,
			            sam_coupa_approval_supplier_information[approval_chain_name] IN {
			                "External form approval for SIM",
			                "External form approval for SIM_cXML"
			            } &&
			            sam_coupa_approval_supplier_information[approvable_relative_status] = "approved"
			        )
			    )
			
			RETURN
			    IF(
			        NOT ISBLANK(InternalSubmitted) && NOT ISBLANK(ExternalApproved),
			        DATEDIFF(InternalSubmitted, ExternalApproved, DAY),
			        BLANK()
			    )
			
			```
		formatString: 0
		displayFolder: Suppliers
		lineageTag: a567ced1-dd32-46e2-804a-93e61017098f

	measure SEReviewerToApproverDuration = ```
			
			VAR SimID = MAX(sam_coupa_suppiler_informations[id])
			VAR IsApproved =
			    CALCULATE(
			        MAX(sam_coupa_approval_supplier_information[approvable_relative_status]),
			        FILTER(
			            sam_coupa_approval_supplier_information,
			            sam_coupa_approval_supplier_information[approvable_relative_id] = SimID
			        )
			    ) = "approved"
			VAR ReviewerDate =
			    CALCULATE(
			        MIN(sam_coupa_approval_supplier_information[approval_date]),
			        FILTER(
			            sam_coupa_approval_supplier_information,
			            sam_coupa_approval_supplier_information[approvable_relative_id] = SimID &&
			            sam_coupa_approval_supplier_information[approver_name] = "Supplier Enablement Review"
			        )
			    )
			VAR ApproverDate =
			    CALCULATE(
			        MAX(sam_coupa_approval_supplier_information[approval_date]),
			        FILTER(
			            sam_coupa_approval_supplier_information,
			            sam_coupa_approval_supplier_information[approvable_relative_id] = SimID &&
			            sam_coupa_approval_supplier_information[approver_name] = "Supplier Enablement Approver"
			        )
			    )
			RETURN
			    IF(
			        IsApproved && NOT ISBLANK(ReviewerDate) && NOT ISBLANK(ApproverDate),
			        DATEDIFF(ReviewerDate, ApproverDate, DAY),
			        BLANK()
			    )
			
			```
		formatString: 0
		displayFolder: Suppliers
		lineageTag: 71ba953c-a4d7-414a-94e0-2bdd47237662

	measure 'Avg Overdue Days' = ```
			
			VAR AsOf = TODAY()
			VAR Inv =
			    SUMMARIZE(
			        FILTER(
			            brl_sap_payments_GL,
			            NOT ISBLANK(brl_sap_payments_GL[DueDate]) &&
			            brl_sap_payments_GL[DueDate] < AsOf
			        ),
			        brl_sap_payments_GL[Commodity mapping],
			        "DueInv", MIN(brl_sap_payments_GL[DueDate])  
			    )
			RETURN
			AVERAGEX(Inv, DATEDIFF([DueInv], AsOf, DAY))
			```
		displayFolder: Working_Capital
		lineageTag: 74c2a3b9-123a-4779-9d87-bb04cdbf6dd1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '# Overdue Invoices' = ```
			
			DISTINCTCOUNT( brl_sap_payments_GL[Commodity mapping] )
			
			```
		formatString: 0
		displayFolder: Working_Capital
		lineageTag: e895ae07-ab13-46ee-93f8-35816875ed0f

	measure '$ Overdue' = ```
			
			SUM(brl_sap_payments_GL[$ Spend])
			
			```
