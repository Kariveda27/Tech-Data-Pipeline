	measure 'Adjusted #Suppliers AIC' = ```
			
			VAR SelectedPercentage = SELECTEDVALUE('Spend %'[Parameter], 0)
			RETURN 
			DISTINCTCOUNT(brl_sap_payments_GL[suppliernumber]) * ( SelectedPercentage / 100)
			
