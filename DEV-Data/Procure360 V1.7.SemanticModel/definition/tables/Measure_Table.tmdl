	measure 'Weighted Payment Days' = ```
			
			SUMX(
			    FILTER(
			        brl_sap_payments_GL,
			        NOT(ISBLANK(brl_sap_payments_GL[$ Spend])) &&
			        NOT(ISBLANK(brl_sap_payments_GL[PaymentDays]))
			    ),
			    brl_sap_payments_GL[$ Spend] * brl_sap_payments_GL[PaymentDays]
			)
			
			```
		displayFolder: Working_Capital
		lineageTag: d8fdba28-170e-4e8c-b4a0-01e6f73dd7d3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weighted Payment Terms' = ```
			
			SUMX(
			    FILTER(
			        brl_sap_payments_GL,
			        NOT(ISBLANK(brl_sap_payments_GL[$ Spend])) &&
			        NOT(ISBLANK(brl_sap_payments_GL[ExtractedPaymentTerms]))
			    ),
			    brl_sap_payments_GL[$ Spend] * brl_sap_payments_GL[ExtractedPaymentTerms]
			)
			
			```
		displayFolder: Working_Capital
		lineageTag: 5a332077-5753-4d9e-8294-a46e04f0191f

