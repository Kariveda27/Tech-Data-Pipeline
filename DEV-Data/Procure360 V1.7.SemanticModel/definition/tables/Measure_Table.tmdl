	measure Adjusted_Spend = ```
			
			VAR SelectedPercentage = SELECTEDVALUE('Spend %'[Parameter], 0)
			RETURN 
			SUM(sam_coupa_invoices_lines[$ Spend]) * ( SelectedPercentage / 100)
			
