	measure Avg_SE_To_FinalApproval_Days = ```
			
			AVERAGEX(
			    VALUES(sam_coupa_approval_supplier_information[approvable_id]),
			    VAR CurrentID = sam_coupa_approval_supplier_information[approvable_id]
			    
			    VAR SubmittedDate =
			        CALCULATE(
			            MIN(sam_coupa_approval_supplier_information[approval_date]),
			            sam_coupa_approval_supplier_information[approvable_id] = CurrentID,
			            sam_coupa_approval_supplier_information[approval_chain_name] = "External form approval for SIM",
			            sam_coupa_approval_supplier_information[approver_name] = "Supplier Enablement Review"
			        )
			        
			    VAR FinalApprovalDate =
			        CALCULATE(
			            MIN(sam_coupa_approval_supplier_information[approval_date]),
			            sam_coupa_approval_supplier_information[approvable_id] = CurrentID,
			            sam_coupa_approval_supplier_information[approval_chain_name] = "External form approval for SIM",
			            sam_coupa_approval_supplier_information[approver_name] = "Supplier Enablement Approver"
			        )
			
			    RETURN
			        IF(
			            NOT ISBLANK(SubmittedDate) && NOT ISBLANK(FinalApprovalDate),
			            DATEDIFF(SubmittedDate, FinalApprovalDate, DAY)
			        )
			)
			
			```
		displayFolder: Suppliers
		lineageTag: 3670c20b-e87e-4fab-80f6-74d833ecd621

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Avg_TAT_For_Suppliers = ```
			
			AVERAGEX(
			    VALUES(sam_coupa_approval_supplier_information[approvable_id]),
			    VAR CurrentID = sam_coupa_approval_supplier_information[approvable_id]
			
			    VAR CreatedDate =
			        CALCULATE(
			            MIN(sam_coupa_approval_supplier_information[SIM_Created_at]),
			            sam_coupa_approval_supplier_information[approvable_id] = CurrentID,
			            sam_coupa_approval_supplier_information[approval_chain_name] = "External form approval for SIM"
			        )
			
			    VAR SubmittedDate =
			        CALCULATE(
			            MIN(sam_coupa_approval_supplier_information[submitted_at]),
			            sam_coupa_approval_supplier_information[approvable_id] = CurrentID,
			            sam_coupa_approval_supplier_information[approval_chain_name] = "External form approval for SIM"
			        )
			
			    RETURN
			        IF(
			            NOT ISBLANK(CreatedDate) && NOT ISBLANK(SubmittedDate),
			            DATEDIFF(CreatedDate, SubmittedDate, DAY)
			        )
			)
			
			```
		displayFolder: Suppliers
		lineageTag: 39f0987c-2007-44f2-a336-72a3e8689aac

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Avg_TAT_Internal_Forms = ```
			
			AVERAGEX(
			    VALUES(sam_coupa_approval_supplier_information[approvable_id]),
			    VAR CurrentID = sam_coupa_approval_supplier_information[approvable_id]
			
			    VAR CreatedDate =
			        CALCULATE(
			            MIN(sam_coupa_approval_supplier_information[submitted_at]),
			            sam_coupa_approval_supplier_information[approvable_id] = CurrentID,
			            sam_coupa_approval_supplier_information[approval_chain_name] = "Internal form approval for SIM",
			            sam_coupa_approval_supplier_information[approvable_status] IN { "applied", "applied_manually" }
			        )
			
			    VAR ApprovedDate =
			        CALCULATE(
			            MAX(sam_coupa_approval_supplier_information[approval_date]),
			            sam_coupa_approval_supplier_information[approvable_id] = CurrentID,
			            sam_coupa_approval_supplier_information[approval_chain_name] = "Internal form approval for SIM",
			            sam_coupa_approval_supplier_information[approvable_status] IN { "applied", "applied_manually" }
			        )
			
			    RETURN
			        IF(
			            NOT ISBLANK(CreatedDate) && NOT ISBLANK(ApprovedDate),
			            DATEDIFF(CreatedDate, ApprovedDate, DAY)
			        )
			)
			
			```
		displayFolder: Suppliers
		lineageTag: 5f9c112c-1df1-4a9b-9c43-73675f7d545e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

