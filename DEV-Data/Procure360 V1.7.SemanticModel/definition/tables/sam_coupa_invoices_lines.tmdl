	column fx_rate_to_usd = ```
			
			CALCULATE(
			    AVERAGE('sam_mapping_currency_table'[ExchangeRate]),
			    FILTER(
			        'sam_mapping_currency_table',
			        'sam_mapping_currency_table'[FromCurrency] = 'sam_coupa_invoices_lines'[accounting_total_currency]
			        && 'sam_mapping_currency_table'[ToCurrency] = "USD"
			        && 'sam_mapping_currency_table'[ValidFromMonth] = 'sam_coupa_invoices_lines'[TransactionMonth]
			         )
			)
			
			```
		dataType: double
		formatString: 0.00
		lineageTag: e15d94d4-63c1-425a-ab98-9f399f7229e0
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column '$ Spend' = ```
			
			IF(
			    'sam_coupa_invoices_lines'[accounting_total_currency] = "USD",
			    'sam_coupa_invoices_lines'[accounting_total],
			    'sam_coupa_invoices_lines'[accounting_total] * 'sam_coupa_invoices_lines'[fx_rate_to_usd])
			
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 1f7a5852-4bc5-4e2e-a54b-76b02e479ba3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Spend Bucket' = ```
			
			SWITCH(
			    TRUE(),
			    sam_coupa_invoices_lines[$ Spend] <= 100000, "0 – 100K",
			    sam_coupa_invoices_lines[$ Spend] <= 250000, "101K – 250K",
			    sam_coupa_invoices_lines[$ Spend] <= 500000, "251K – 500K",
			    sam_coupa_invoices_lines[$ Spend] <= 1000000, "501K – 1M",
			    sam_coupa_invoices_lines[$ Spend] <= 10000000, "1M – 10M",
			    sam_coupa_invoices_lines[$ Spend] > 10000000, "> 10M",
			    "Unknown"
			)
			
			```
		lineageTag: 0887ae97-a6b8-4ffc-8c08-15477bd9a829
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Spend Bucket Sort' = ```
			
			SWITCH(
			    TRUE(),
			    sam_coupa_invoices_lines[$ Spend] <= 100000, "A",
			    sam_coupa_invoices_lines[$ Spend] <= 250000, "B",
			    sam_coupa_invoices_lines[$ Spend] <= 500000, "C",
			    sam_coupa_invoices_lines[$ Spend] <= 1000000, "D",
			    sam_coupa_invoices_lines[$ Spend] <= 10000000, "E",
			    sam_coupa_invoices_lines[$ Spend] > 10000000, "F",
			    "Z"
			)
			
			```
		lineageTag: e1e20c20-49bf-4131-a24c-cc2cf57ab5a9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Invoice Value Bucket' = ```
			
			SWITCH(
			    TRUE(),
			    'sam_coupa_invoices_lines'[$ Spend] < 0, "< 0",
			    'sam_coupa_invoices_lines'[$ Spend] >= 0 && 'sam_coupa_invoices_lines'[$ Spend] <= 100, "0 - 100",
			    'sam_coupa_invoices_lines'[$ Spend] >= 101 && 'sam_coupa_invoices_lines'[$ Spend] <= 500, "101 - 500",
			    'sam_coupa_invoices_lines'[$ Spend] >= 501 && 'sam_coupa_invoices_lines'[$ Spend] <= 1000, "501 - 1,000",
			    'sam_coupa_invoices_lines'[$ Spend] >= 1001 && 'sam_coupa_invoices_lines'[$ Spend] <= 5000, "1,001 - 5,000",
			    'sam_coupa_invoices_lines'[$ Spend] >= 5001 && 'sam_coupa_invoices_lines'[$ Spend] <= 10000, "5,001 - 10,000",
			    'sam_coupa_invoices_lines'[$ Spend] >= 10001 && 'sam_coupa_invoices_lines'[$ Spend] <= 50000, "10,001 - 50,000",
			    'sam_coupa_invoices_lines'[$ Spend] >= 50001 && 'sam_coupa_invoices_lines'[$ Spend] <= 100000, "50,001 - 100,000",
			    'sam_coupa_invoices_lines'[$ Spend] >= 100001 && 'sam_coupa_invoices_lines'[$ Spend] <= 250000, "100,001 - 250,000",
			    'sam_coupa_invoices_lines'[$ Spend] >= 250001 && 'sam_coupa_invoices_lines'[$ Spend] <= 500000, "250,001 - 500,000",
			    'sam_coupa_invoices_lines'[$ Spend] > 500000, "> 500,000",
			    "Other"
			)
			
			```
		lineageTag: 070f8ebf-cd2a-48af-85a6-05f4310ff74a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

