	column U_ID = sam_coupa_invoices_lines[#Invoices] & sam_coupa_invoices_lines[header_supplier_number] & sam_coupa_invoices_lines[gl_code]
		lineageTag: 330ee028-4ca4-4bcb-9846-a90d15865322
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column IsCommodityMismatch = ```
			
			VAR UIDValue = sam_coupa_invoices_lines[U_ID]
			VAR DistinctCommodities =
			    CALCULATE(
			        DISTINCTCOUNT(sam_coupa_invoices_lines[commodity_name]),
			        FILTER(sam_coupa_invoices_lines, sam_coupa_invoices_lines[U_ID] = UIDValue)
			    )
			RETURN IF(DistinctCommodities > 1, 1, 0)
			
			```
		formatString: 0
		lineageTag: 99380fd1-b9ba-49e6-aeb7-b9e5d6d0c8a1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ResolvedCommodity = ```
			
			VAR ThisUID = sam_coupa_invoices_lines[U_ID]
			VAR ThisCommodity = sam_coupa_invoices_lines[commodity_name]
			VAR IsBlankCommodity = ISBLANK(ThisCommodity)
			
			-- All rows with same UID and non-blank commodity
			VAR RelatedRowsWithCommodity =
			    FILTER(
			        sam_coupa_invoices_lines,
			        sam_coupa_invoices_lines[U_ID] = ThisUID && NOT ISBLANK(sam_coupa_invoices_lines[commodity_name])
			    )
			
			-- Count distinct commodities for that UID
			VAR DistinctCommodities =
			    CALCULATE(
			        DISTINCTCOUNT(sam_coupa_invoices_lines[commodity_name]),
			        FILTER(
			            sam_coupa_invoices_lines,
			            sam_coupa_invoices_lines[U_ID] = ThisUID && NOT ISBLANK(sam_coupa_invoices_lines[commodity_name])
			        )
			    )
			
			-- Top-spend commodity for this UID
			VAR TopCommodity =
			    CALCULATE(
			        MAXX(
			            TOPN(
			                1,
			                RelatedRowsWithCommodity,
			                sam_coupa_invoices_lines[accounting_total],
			                DESC
			            ),
			            sam_coupa_invoices_lines[commodity_name]
			        )
			    )
			
			RETURN
			    IF(
			        DistinctCommodities > 1 || IsBlankCommodity,
			        IF(
			            ISBLANK(TopCommodity),
			            "Uncategorised",
			            TopCommodity
			        ),
			        ThisCommodity
			    )
			
			```
		lineageTag: 823f71fb-7ffc-4124-9016-f61f71a0c5e8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

