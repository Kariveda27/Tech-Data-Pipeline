	column Delayed_Receipt_of_Inv = ```
			
			VAR Delay = DATEDIFF('sam_coupa_invoices_lines'[header_invoice_date], 'sam_coupa_invoices_lines'[created_at], DAY)
			VAR Channel = 'sam_coupa_invoices_lines'[CSP vs others]
			RETURN
			SWITCH(
			    TRUE(),
			    (Channel = "Manual" && Delay >= 3), 1,
			    (Channel IN {"CSP", "Other"} && Delay >= 1), 1,
			    0
			)
			
			```
		formatString: 0
		lineageTag: d61627e7-0e94-486a-871e-67db19e2beae
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Late_Submission_Bucket = ```
			
			VAR Delay = 'sam_coupa_invoices_lines'[Late_Submission]
			VAR Channel = 'sam_coupa_invoices_lines'[CSP vs others]
			VAR IsLate =
			    (Channel = "Manual" && Delay >= 3) ||
			    (Channel IN { "CSP", "Other" } && Delay >= 1)
			RETURN
			IF(
			    IsLate,
			    SWITCH(
			        TRUE(),
			        Delay >= 0 && Delay <= 30, "0–30 Days",
			        Delay >= 31 && Delay <= 60, "31–60 Days",
			        Delay >= 61 && Delay <= 90, "61–90 Days",
			        Delay >= 91 && Delay <= 120, "91–120 Days",
			        Delay >= 121 && Delay <= 150, "121–150 Days",
			        Delay >= 151 && Delay <= 180, "151–180 Days",
			        Delay >= 181 && Delay <= 365, "181–365 Days",
			        Delay > 365, "> 365 Days"
			    )
			)
			
			```
		lineageTag: bc90d746-f15d-402f-8e57-322f7ab0795a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

