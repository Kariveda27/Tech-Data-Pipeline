	column 'Aged Invoice Bucket' = ```
			
			VAR Age = DATEDIFF('sam_coupa_invoices_lines'[header_invoice_date], TODAY(), DAY)
			RETURN
			SWITCH(
			    TRUE(),
			    Age >= 0 && Age <= 30, "0–30 Days",
			    Age >= 31 && Age <= 60, "31–60 Days",
			    Age >= 61 && Age <= 90, "61–90 Days",
			    Age >= 91 && Age <= 120, "91–120 Days",
			    Age >= 121 && Age <= 150, "121–150 Days",
			    Age >= 151 && Age <= 180, "151–180 Days",
			    Age >= 181 && Age <= 365, "181–365 Days",
			    Age > 365, "> 365 Days",
			    BLANK()
