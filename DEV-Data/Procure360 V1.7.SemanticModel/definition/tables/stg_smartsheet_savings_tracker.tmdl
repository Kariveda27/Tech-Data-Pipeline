table stg_smartsheet_savings_tracker
	lineageTag: 6ac4f39a-d941-4c88-bc6a-47aa87c824f7

	measure 'Total 2025 Savings' = ```
			
			CALCULATE(
			    SUMX(
			        ADDCOLUMNS(
			            SUMMARIZE(
			                'stg_smartsheet_savings_tracker',
			                'stg_smartsheet_savings_tracker'[saving reference number],
			                'stg_smartsheet_savings_tracker'[raw savings type],
			                'stg_smartsheet_savings_tracker'[Year]
			            ),
			            "TotalValue", CALCULATE(SUM('stg_smartsheet_savings_tracker'[value]))
			        ),
			        [TotalValue]
			    ),
			    'stg_smartsheet_savings_tracker'[Year] = 2025
			)
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 6feb9965-c3f4-4fe9-b11e-bf0976bd6e36

	measure 'Validated 2025 Savings' = ```
			
			SUMX (
			    SUMMARIZE (
			        FILTER (
			            'stg_smartsheet_savings_tracker',
			            'stg_smartsheet_savings_tracker'[validated (this replaced the checkbox)] = "Yes"
			                && 'stg_smartsheet_savings_tracker'[year] = 2025
			        ),
			        'stg_smartsheet_savings_tracker'[saving reference number],
			        'stg_smartsheet_savings_tracker'[raw savings type],
			        'stg_smartsheet_savings_tracker'[year],
			        "SumPerProject", SUM('stg_smartsheet_savings_tracker'[value])
			    ),
			    [SumPerProject]
			)
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 055369ea-c0ca-4432-aa1a-834c26484613

	measure 'Total WACC %' = ```
			
			SUMX (
			    VALUES('stg_smartsheet_savings_tracker'[saving reference number]),
			    CALCULATE(MAX('stg_smartsheet_savings_tracker'[wacc %]))
			)
			
			```
		lineageTag: 45b51025-337d-454a-84fb-66a7ec738788

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Cycle Time Improvement %' = ```
			
			SUMX (
			    VALUES('stg_smartsheet_savings_tracker'[saving reference number]),
			    CALCULATE(MAX('stg_smartsheet_savings_tracker'[cycle time improvement (%)])
			))
			
			```
		lineageTag: 3d5c236c-1f4b-4e84-8d9a-29bc1a88ede8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Savings_Actuals_All = ```
			
			CALCULATE(
			    SUM('stg_smartsheet_savings_tracker'[Value]),
			    KEEPFILTERS(
			        'stg_smartsheet_savings_tracker'[saving status] IN {
			            "Actual", "WIP", "Forecast", "Not Started", "Cancelled"
			        }
			    ),
			    REMOVEFILTERS('stg_smartsheet_savings_tracker'[Raw Savings Type]),
			    ALLEXCEPT('stg_smartsheet_savings_tracker', 'stg_smartsheet_savings_tracker'[Saving Reference Number], 'stg_smartsheet_savings_tracker'[saving status])
			)
			
			```
		lineageTag: cd9b18d8-13d9-47e0-a8d5-decb1a3f5eae

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Savings_Target = ```
			
			CALCULATE(
			    SUM('stg_smartsheet_savings_tracker'[Value]),
			    'stg_smartsheet_savings_tracker'[saving status] = "Target ( For GPLT Savings Target)"
			)
			
			```
		lineageTag: b07d5673-939f-41c6-884b-5cb1c6e5e0b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'WIP Savings 2025' =
			
			CALCULATE(
			    [Total 2025 Savings],
			    'stg_smartsheet_savings_tracker'[saving status] = "WIP"
			)
		lineageTag: f422d830-2c0c-40f8-b662-3eb9ef8f0c29

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Savings 2025' =
			
			CALCULATE(
			    [Total 2025 Savings],
			    'stg_smartsheet_savings_tracker'[saving status] = "Forecast"
			)
		lineageTag: 2feb1c40-53a6-45bb-9bb1-5bc78687cecd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'NotStarted Savings 2025' =
			
			CALCULATE(
			    [Total 2025 Savings],
			    'stg_smartsheet_savings_tracker'[saving status] = "Not Started"
			)
		lineageTag: 5dc26ac1-b1d2-4cfc-a874-b541a6b06a6e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Target Savings Measure' = ```
			
			CALCULATE(
			    SUM('Target_Savings'[Target]),
			    TREATAS(VALUES('stg_smartsheet_savings_tracker'[gplt owner]), 'Target_Savings'[GPLT Owner])
			)
			
			```
		lineageTag: e282de57-d657-4809-9207-90ba1b05fe7d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Savings_By_Status = ```
			
			SWITCH(
			    SELECTEDVALUE(Savings_Pipeline_Stack[Status]),
			    "Actual", [Actual Savings 2025],
			    "WIP", [WIP Savings 2025],
			    "Forecast", [Forecast Savings 2025],
			    "Not Started", [NotStarted Savings 2025],
			    "Target", [Target Savings Measure]
			)
			
			```
		lineageTag: f09f90da-0519-466a-9339-bf76feb5cd14

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Actual Savings 2025' =
			
			CALCULATE(
			    [Total 2025 Savings],
			    'stg_smartsheet_savings_tracker'[saving status] = "Actual"
			)
		lineageTag: cbb6c715-83f4-4d99-88c7-104f999cd7ac

		annotation PBI_FormatHint = {"isGeneralNumber":true}

