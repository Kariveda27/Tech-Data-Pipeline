		extendedProperty ParameterMetadata =
				{
				  "version": 0
				}

		annotation SummarizationSetBy = User

	partition 'Scenario Payment Terms' = calculated
		mode: import
		source = GENERATESERIES(15, 120, 5)

	annotation PBI_Id = 39cce7ef87fb4276a47997b2d98c1211

