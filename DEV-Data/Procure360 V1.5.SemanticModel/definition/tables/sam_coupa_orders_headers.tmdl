table sam_coupa_orders_headers
	lineageTag: b9ab97fa-2cf6-4c95-8e7a-5e7459334e87

	column 'Contract Flag' = ```
			
			VAR CurrentPO = 'sam_coupa_orders_headers'[id]
			RETURN
			IF (
			    CALCULATE (
			        COUNTROWS (
			            FILTER (
			                'sam_coupa_orders_lines',
			                'sam_coupa_orders_lines'[order_header_id] = CurrentPO &&
			                NOT ISBLANK('sam_coupa_orders_lines'[contract_id])
			            )
			        )
			    ) > 0,
			    "With Contract",
			    "Without Contract"
			)
			
			```
		lineageTag: 5830d898-4f78-4776-9e06-4f7538099733
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'PO Value Bucket' = ```
			
			VAR CleanPOValue = 
			    IF(
			        ISBLANK('sam_coupa_orders_headers'[PO Value in USD]) || 'sam_coupa_orders_headers'[PO Value in USD] = 0,
			        BLANK(),
			        'sam_coupa_orders_headers'[PO Value in USD]
			    )
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(CleanPOValue), "No PO Value",
			    CleanPOValue < 1000, "< $1K",
			    CleanPOValue < 10000, "$1K - $10K",
			    CleanPOValue < 25000, "$10K - $25K",
			    CleanPOValue < 100000, "$25K - $100K",
			    CleanPOValue < 250000, "$100K - $250K",
			    CleanPOValue < 500000, "$250K - $500K",
			    CleanPOValue < 750000, "$500K - $750K",
			    CleanPOValue < 1000000, "$750K - $1M",
			    CleanPOValue >= 1000000, "> $1M",
			    "Unknown"
			)
			
			```
		lineageTag: c56fc5de-7756-484a-9215-41df8fbffc42
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'PO Value Bucket Sort' = ```
			
			SWITCH(
			    TRUE(),
			    'sam_coupa_orders_headers'[PO Value in USD] < 1000, "A",
			    'sam_coupa_orders_headers'[PO Value in USD] < 10000, "B",
			    'sam_coupa_orders_headers'[PO Value in USD] < 25000, "C",
			    'sam_coupa_orders_headers'[PO Value in USD] < 100000, "D",
			    'sam_coupa_orders_headers'[PO Value in USD] < 250000, "E",
			    'sam_coupa_orders_headers'[PO Value in USD] < 500000, "F",
			    'sam_coupa_orders_headers'[PO Value in USD] < 750000, "G",
			    'sam_coupa_orders_headers'[PO Value in USD] < 1000000, "H",
			    'sam_coupa_orders_headers'[PO Value in USD] >= 1000000, "I",
			    "Z"
			)
			
			```
		lineageTag: f6c45c63-cd0a-4f83-af0d-082360040fe3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

