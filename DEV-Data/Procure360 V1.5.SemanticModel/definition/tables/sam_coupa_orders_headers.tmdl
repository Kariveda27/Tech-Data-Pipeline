	column 'Category 4' = ```
			
			VAR SelectedOrderID = sam_coupa_orders_headers[id]
			VAR MaxSpend =
			    CALCULATE(
			        MAX(sam_coupa_orders_lines[PO Spend in USD]),
			        FILTER(
			            sam_coupa_orders_lines,
			            sam_coupa_orders_lines[order_header_id] = SelectedOrderID
			        )
			    )
			RETURN
			CALCULATE(
			    MAX(sam_coupa_orders_lines[commodity]),
			    FILTER(
			        sam_coupa_orders_lines,
			        sam_coupa_orders_lines[order_header_id] = SelectedOrderID &&
			        sam_coupa_orders_lines[PO Spend in USD] = MaxSpend
			    )
			)
			
			```
		lineageTag: 9f1dc5df-6070-4d6f-b552-0bcba7d05dc9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

