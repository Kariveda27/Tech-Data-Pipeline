		lineageTag: a629af6e-40c9-4022-a2bc-40158dae1470
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ExtractedPaymentTerms = ```
			
			SWITCH(
			    TRUE(),
			    sam_coupa_invoices_headers[payment_term] IN {"0001", "CRED", "IC00", "LPA", "NT00", "PFP", "RID"}, 0,
			    sam_coupa_invoices_headers[payment_term] = "IN69", 75,
			    sam_coupa_invoices_headers[payment_term] = "ME30", 30,
			    sam_coupa_invoices_headers[payment_term] = "ME60", 60,
			    sam_coupa_invoices_headers[payment_term] = "NT07", 7,
			    sam_coupa_invoices_headers[payment_term] = "NT08", 8,
			    sam_coupa_invoices_headers[payment_term] = "NT14", 14,
			    sam_coupa_invoices_headers[payment_term] = "NT15", 15,
			    sam_coupa_invoices_headers[payment_term] = "NT28", 28,
			    sam_coupa_invoices_headers[payment_term] = "NT30", 30,
			    sam_coupa_invoices_headers[payment_term] = "NT45", 45,
			    sam_coupa_invoices_headers[payment_term] = "NT60", 60,
			    sam_coupa_invoices_headers[payment_term] = "NT90", 90,
			    BLANK()
			)
			
