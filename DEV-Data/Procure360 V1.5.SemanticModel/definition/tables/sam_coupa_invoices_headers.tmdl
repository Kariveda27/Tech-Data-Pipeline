	column LatePaymentDaysBucket = ```
			
			VAR DaysLate = sam_coupa_invoices_headers[LatePaymentDays]
			RETURN
			IF(
			    DaysLate > 0,
			    SWITCH(
			        TRUE(),
			        DaysLate <= 7,  "1–7 Days",
			        DaysLate <= 14, "8–14 Days",
			        DaysLate <= 30, "15–30 Days",
			        DaysLate <= 60, "31–60 Days",
			        DaysLate > 60,  ">60 Days"
			    ),
			    BLANK()
			)
			
