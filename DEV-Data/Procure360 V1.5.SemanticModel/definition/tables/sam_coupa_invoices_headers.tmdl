	column DueDate_createdat = ```
			
			IF(
			    ISBLANK('sam_coupa_invoices_headers'[created_at]) || ISBLANK('sam_coupa_invoices_headers'[ExtractedPaymentTerms]),
			    BLANK(),
			    'sam_coupa_invoices_headers'[created_at] + 'sam_coupa_invoices_headers'[ExtractedPaymentTerms]
			)
			
