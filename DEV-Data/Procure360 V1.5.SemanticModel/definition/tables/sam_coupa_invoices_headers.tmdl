	column LatestApprovalDate = ```
			
			CALCULATE(
			    MAX(sam_coupa_approvals_invoices[approval_date]),
			    FILTER(sam_coupa_approvals_invoices, sam_coupa_approvals_invoices[approvable_relative_id] = sam_coupa_invoices_headers[id])
			)
			
			```
		formatString: dd/mm/yyyy
		lineageTag: 41cd6b86-b9ed-4921-b5cb-1b47e14d861c
		summarizeBy: none

