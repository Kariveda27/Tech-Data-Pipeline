	column 'Retro PO Flag' = ```
			
			VAR PODate = RELATED(sam_coupa_orders_headers[created_at])
			VAR EarliestInvoiceDate =
			    CALCULATE(
			        MIN(sam_coupa_invoices_lines[created_at]),
			        RELATEDTABLE(sam_coupa_invoices_lines)
			    )
			RETURN
			IF(
			    NOT ISBLANK(EarliestInvoiceDate) &&
			    EarliestInvoiceDate < PODate,
			    1,
			    0
			)
			
			```
		formatString: 0
		lineageTag: 25d4f0fa-cd68-4edc-b507-332326729958
