table sam_coupa_orders_lines
	lineageTag: 227eaa74-5bb4-4583-b0c4-c9e30fc21eab

	column TransactionMonth = ```
			
			DATE(YEAR('sam_coupa_orders_lines'[created_at]), MONTH('sam_coupa_orders_lines'[created_at]), 1)
			
			```
		formatString: Long Date
		lineageTag: 3e0aec48-39df-427e-b14b-3ab4549dc4fd
		summarizeBy: none

		variation Variation
			isDefault
			relationship: bc9135c4-4141-45e5-a2d7-4499f7ad351d
			defaultHierarchy: LocalDateTable_af75e2f5-8e28-4321-8f33-b8e9669c3537.'Date Hierarchy'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'FX Rate to USD' = ```
			
			CALCULATE(
			    AVERAGE('sam_mapping_currency_table'[ExchangeRate]),
			    FILTER(
			        'sam_mapping_currency_table',
			        'sam_mapping_currency_table'[FromCurrency] = 'sam_coupa_orders_lines'[accounting_total_currency]
			        && 'sam_mapping_currency_table'[ToCurrency] = "USD"
			        && 'sam_mapping_currency_table'[ValidFromMonth] = 'sam_coupa_orders_lines'[TransactionMonth]
			         )
			)
			
			```
		lineageTag: 9ac979bd-14fa-42fd-b34c-c66068041e4c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'PO Spend in USD' = ```
			
			IF(
			    'sam_coupa_orders_lines'[accounting_total_currency] = "USD",
			    'sam_coupa_orders_lines'[accounting_total],
			    'sam_coupa_orders_lines'[accounting_total] * 'sam_coupa_orders_lines'[FX Rate to USD]
			)
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: e66c1fd6-4c27-4959-bb19-5b4a69f9ae11
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

