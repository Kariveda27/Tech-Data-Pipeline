	column 'Requisition Approval Status' = ```
			
			IF (
			    'sam_coupa_requisition_headers'[status] IN { "ordered", "partially_received", "received" },
			    "Approved",
			    "Pending Approval"
			)
			
			```
		lineageTag: 795baae1-ec9c-4a88-8508-db0bb56d79ec
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Latest Approval Date' = ```
			
			CALCULATE(
			    MAX('sam_coupa_approval_requisitions'[approval_date]),
			    FILTER(
			        'sam_coupa_approval_requisitions',
			        'sam_coupa_approval_requisitions'[approvable_id] = 'sam_coupa_requisition_headers'[id]
			    )
			)
			
			```
		formatString: General Date
		lineageTag: 55876937-a7fd-48a7-b3db-ac199607ede6
