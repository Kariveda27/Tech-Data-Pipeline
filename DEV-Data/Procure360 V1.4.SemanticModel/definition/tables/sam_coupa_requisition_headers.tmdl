	column 'Commodity Name (Resolved)' = ```
			
			VAR ReqID = 'sam_coupa_requisition_headers'[id]
			RETURN
			    CALCULATE(
			        MAXX(
			            TOPN(
			                1,
			                FILTER(
			                    'sam_coupa_requisition_lines',
			                    'sam_coupa_requisition_lines'[requisition_header_id] = ReqID
			                ),
			                'sam_coupa_requisition_lines'[line_total], DESC
			            ),
			            'sam_coupa_requisition_lines'[commodity_name]
			        )
			    )
			
			```
		lineageTag: b6b66080-3c43-4c49-b8af-922fdccdfb83
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Category 3' = LOOKUPVALUE('sam_mapping_category_gplt'[l3_category],'sam_mapping_category_gplt'[l4_category],sam_coupa_requisition_headers[Commodity Name (Resolved)])
