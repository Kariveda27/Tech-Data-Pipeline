			defaultHierarchy: LocalDateTable_0f26d55c-e92d-427d-9c20-86135c3bfa2f.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Approval Cycle Time (Days)' = ```
			
			DATEDIFF(
			    'sam_coupa_requisition_headers'[submitted_at_date],
			    'sam_coupa_requisition_headers'[Latest Approval Date],
			    DAY
			)
			
			```
		formatString: 0
		lineageTag: d0c5b766-8ead-4458-a55d-21388a33fa95
