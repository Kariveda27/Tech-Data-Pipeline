table sam_coupa_requisition_headers
	lineageTag: 2d128f34-4250-4104-88a6-084a9cc66430

	column TransactionMonth = ```
			
			DATE(YEAR('sam_coupa_requisition_headers'[created_at_date]), MONTH('sam_coupa_requisition_headers'[created_at_date]), 1)
			
			```
		formatString: General Date
		lineageTag: 56900693-d086-42b0-b734-84d461dd7a1b
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 74763d3b-8d12-4e8f-97f5-9ad3fdfabbc7
			defaultHierarchy: LocalDateTable_d22ce483-2320-405f-9634-94bfd08ce449.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'FX Rate to USD' = ```
			
			CALCULATE(
			    AVERAGE('sam_mapping_currency_table'[ExchangeRate]),
			    FILTER(
			        'sam_mapping_currency_table',
			        'sam_mapping_currency_table'[FromCurrency] = 'sam_coupa_requisition_headers'[currency_code]
			         && 'sam_mapping_currency_table'[ToCurrency] = "USD"
			        && 'sam_mapping_currency_table'[ValidFromMonth] = 'sam_coupa_requisition_headers'[TransactionMonth]
			    )
			)
			
			```
		dataType: double
		lineageTag: 7efa7f23-3077-4ad7-a39a-9afe853fd1c7
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Req. Spend in USD' = ```
			
			IF(
			    'sam_coupa_requisition_headers'[currency_code] = "USD",
			    'sam_coupa_requisition_headers'[total],
			    'sam_coupa_requisition_headers'[total] * 'sam_coupa_requisition_headers'[FX Rate to USD]
			)
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 7d2c817d-b8e6-4480-ac0e-365a903cc818
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

